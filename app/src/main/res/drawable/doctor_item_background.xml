<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shadow layer -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#80000000" /> <!-- Semi-transparent black for shadow -->
            <corners android:radius="16dp" /> <!-- Rounded corners for shadow -->
        </shape>
    </item>

    <!-- Background layer with rounded corners -->
    <item android:top="4dp" android:bottom="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" /> <!-- White background -->
            <corners android:radius="16dp" /> <!-- Rounded corners for the card -->
        </shape>
    </item>

</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@android:color/white"
    tools:context=".BookingAppointment">

    <!-- Title -->
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Book Doctor Appointment"
        android:textStyle="bold"
        android:textSize="24sp"
        android:textColor="@color/black"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp" />

    <!-- Patient Name -->
    <TextView
        android:id="@+id/patient_name_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Patient Name"
        android:textSize="16sp"
        android:layout_below="@id/title"
        android:layout_marginTop="24dp" />

    <EditText
        android:id="@+id/patient_name_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter your name"
        android:layout_below="@id/patient_name_label"
        android:layout_marginTop="8dp"
        android:padding="12dp"
        android:background="@drawable/edit_text_background"/>

    <!-- Appointment Date -->
    <TextView
        android:id="@+id/appointment_date_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Appointment Date"
        android:textSize="16sp"
        android:layout_below="@id/patient_name_input"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/date_display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Date"
        android:textSize="16sp"
        android:layout_below="@id/appointment_date_label"
        android:padding="12dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/edit_text_background"/>

    <Button
        android:id="@+id/select_date_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Date"
        android:layout_below="@id/date_display"
        android:layout_marginTop="8dp"
        android:background="@drawable/button_background"/>

    <!-- Appointment Time -->
    <TextView
        android:id="@+id/appointment_time_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Appointment Time"
        android:textSize="16sp"
        android:layout_below="@id/select_date_button"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/time_display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Time"
        android:textSize="16sp"
        android:layout_below="@id/appointment_time_label"
        android:padding="12dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/edit_text_background"/>

    <Button
        android:id="@+id/select_time_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Time"
        android:layout_below="@id/time_display"
        android:layout_marginTop="8dp"
        android:background="@drawable/button_background"/>

    <!-- Select Doctor -->
    <TextView
        android:id="@+id/select_doctor_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Doctor"
        android:textSize="16sp"
        android:layout_below="@id/select_time_button"
        android:layout_marginTop="16dp" />

    <Spinner
        android:id="@+id/doctor_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/select_doctor_label"
        android:layout_marginTop="8dp"
        android:background="@drawable/spinner_background"/>

    <!-- Submit Button -->
    <Button
        android:id="@+id/submit_appointment_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Book Appointment"
        android:textSize="18sp"
        android:textColor="@android:color/white"
        android:layout_below="@id/doctor_spinner"
        android:layout_marginTop="24dp"
        android:background="@drawable/button_background"/>

</RelativeLayout>

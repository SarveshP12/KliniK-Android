<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/med_background"
    android:padding="16dp">

    <!-- Profile Section with Image and Name -->
    <LinearLayout
        android:id="@+id/profile_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@drawable/circle_background"
        android:layout_alignParentTop="true">

        <ImageView
            android:id="@+id/profile_image"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_profile"
            android:layout_marginEnd="12dp"
            android:background="@drawable/circle_background"
            android:scaleType="centerCrop"
            android:layout_marginLeft="5dp"/>

        <TextView
            android:id="@+id/profile_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NAME"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Grid Layout for 4 options -->
    <GridLayout
        android:id="@+id/dashboard_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/profile_section"
        android:columnCount="2"
        android:rowCount="2"
        android:layout_marginBottom="24dp">

        <!-- Card 1: Appointments -->
        <LinearLayout
            android:id="@+id/card_appointments"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:gravity="center"
            android:padding="16dp"
            android:layout_margin="8dp">

            <TextView
                android:id="@+id/btn_view_appointments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Appointments"
                android:textSize="16sp"
                android:textColor="@android:color/black" />
        </LinearLayout>

        <!-- Card 2: Medical Records -->
        <LinearLayout
            android:id="@+id/card_medical_records"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:gravity="center"
            android:padding="16dp"
            android:layout_margin="8dp">

            <TextView
                android:id="@+id/btn_view_medical_records"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medical Records"
                android:textSize="16sp"
                android:textColor="@android:color/black" />
        </LinearLayout>

        <!-- Card 3: Prescriptions -->
        <LinearLayout
            android:id="@+id/card_prescriptions"
            android:layout_width="1dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:gravity="center"
            android:padding="16dp"
            android:layout_margin="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prescriptions"
                android:textSize="16sp"
                android:textColor="@android:color/black" />
        </LinearLayout>

        <!-- Card 4: Lab Results -->
        <LinearLayout
            android:id="@+id/card_lab_results"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:gravity="center"
            android:padding="16dp"
            android:layout_margin="8dp">

            <TextView
                android:id="@+id/btn_order_medicine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lab Results"
                android:textSize="16sp"
                android:textColor="@android:color/black" />
        </LinearLayout>
    </GridLayout>
    <!-- Chatbot Button -->
    <Button
        android:id="@+id/chatbot_button"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:text="Chatbot"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/colorAccent"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:background="@drawable/rounded_button_background" />

</RelativeLayout>

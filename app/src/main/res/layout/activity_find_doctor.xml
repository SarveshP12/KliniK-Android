<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/med_background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Find Doctor"
        android:textAlignment="center"
        android:textSize="30dp"
        android:textColor="@color/dblue"
        android:textStyle="bold"/>
    <!-- Top Filter Section -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Example Filter Buttons -->
            <Button
                android:id="@+id/dental_specialist_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dental Specialist"
                android:backgroundTint="@color/white"
                android:textColor="@color/black" />

            <Button
                android:id="@+id/heart_specialist_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Heart Specialist"
                android:backgroundTint="@color/white"
                android:textColor="@color/black"
                android:layout_marginStart="8dp" />

            <Button
                android:id="@+id/medicine_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Child Specialist"
                android:backgroundTint="@color/white"
                android:textColor="@color/black"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- RecyclerView for Doctor List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/doctorRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp" />
</LinearLayout>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PatientDashboard"
    android:background="@drawable/med_background">

    <LinearLayout
        android:id="@+id/profile_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@drawable/circle_background"
        android:layout_alignParentTop="true"
        android:layout_marginTop="40dp">

        <ImageView
            android:id="@+id/profile_image"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_profile"
            android:layout_marginEnd="12dp"
            android:background="@drawable/circle_background"
            android:scaleType="centerCrop"
            android:layout_marginLeft="5dp"/>

        <TextView
            android:id="@+id/profile_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NAME"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/settings_icon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="end"
            android:layout_marginStart="12dp"
            android:contentDescription="Settings"
            android:onClick="openSettingsActivity"
            android:src="@drawable/ic_settings"
            tools:ignore="OnClick" />


    </LinearLayout>


    <GridLayout
        android:id="@+id/grid_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:alignmentMode="alignMargins"
        android:columnCount="2"
        android:rowCount="2"
        android:padding="16dp"
        tools:ignore="NotSibling"
        android:layout_below="@id/profile_section">

        <!-- Booking Appointment -->
        <LinearLayout
            android:id="@+id/btn_book_appointment"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="25dp"
            android:background="@drawable/card_background">
            <ImageView
                android:id="@+id/booking_appointment_icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_booking_appointment"
                android:contentDescription="Booking Appointment" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View Appointments"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:gravity="center"/>
        </LinearLayout>

        <!-- Medical Records -->
        <!-- Ordering Medicines -->
        <LinearLayout
            android:id="@+id/btn_order_medicine"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="25dp"
            android:background="@drawable/card_background">
            <ImageView
                android:id="@+id/ordering_medicine_icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_order_medicine"
                android:contentDescription="Ordering Medicines" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ordering Medicines"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:gravity="center"/>
        </LinearLayout>

        <!-- Medical Records -->
        <LinearLayout
            android:id="@+id/btn_medical_records"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="25dp"
            android:background="@drawable/card_background">
            <ImageView
                android:id="@+id/medical_records_icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_medical_records"
                android:contentDescription="Medical Records" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medical Records"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:gravity="center"/>
        </LinearLayout>

        <!-- Telemedicine -->
        <LinearLayout
            android:id="@+id/btn_telemedicine"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="25dp"
            android:background="@drawable/card_background">
            <ImageView
                android:id="@+id/telemedicine_icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_telemedicine"
                android:contentDescription="Telemedicine" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Telemedicine"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:gravity="center"/>

        </LinearLayout>

    </GridLayout>

    <!-- Chatbot FloatingActionButton -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_chatbot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_chatbot"
        android:contentDescription="Chatbot"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp"
        app:backgroundTint="@color/colorAccent"
        app:elevation="8dp" />

</RelativeLayout>
